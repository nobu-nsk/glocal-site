---
// 周辺・おでかけのご案内の本体。施設1件ぶんを、指定された言語で描く。
//
// 印刷用のA4シート（build_sheet.py）と同じ spots.csv から作っている。
// 所要時間は実測値で、表記の出し分け（徒歩のみ／徒歩と車／車のみ）も印刷版と同じ。
//
// JavaScriptは、セクション先頭のGoogle地図だけに使う。本文・言語切り替え・リンクは
// JavaScriptなしで成立する（地図が出なくてもページは完全に読める）。
// APIキーが設定されていないビルドでは地図そのものを出さない。
//
// QRはスマホでは出さない。自分が持っている端末の画面に出たQRは読み取れないので、
// 幅の狭い画面ではリンクのボタンだけにしてある。QRはPCで見ている人が手元に渡すためのもの。
import SpotMap from './SpotMap.astro';

const { prop, lang } = Astro.props;
const mapsKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || '';
const mapsId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID || 'DEMO_MAP_ID';

const T = {
  ja: {
    eyebrow: '周辺とおでかけのご案内',
    lead: '所要時間は宿の前から実際に測ったものです。営業時間は変わることがありますので、お出かけ前に地図アプリでご確認ください。',
    open: '地図を開く',
    site: '公式サイト',
    closed: '定休',
    qrCap: '別の端末で開くときはこちら',
    other: 'English',
    updated: '更新',
    foot: '合同会社グローカルコミューン ／ このページは予告なく更新されることがあります。',
    jumpLabel: 'ページ内の行き先',
  },
  en: {
    eyebrow: 'Around & Days Out',
    lead: 'The travel times were measured from the front of the house. Opening hours change from time to time, so please check the map app before you set out.',
    open: 'Open in maps',
    site: 'Website',
    closed: 'Closed',
    qrCap: 'Scan to open on another device',
    other: '日本語',
    updated: 'Updated',
    foot: 'Glocal Commune LLC · This page may be updated without notice.',
    jumpLabel: 'Jump to a section',
  },
};

const t = T[lang];
const otherLang = lang === 'ja' ? 'en' : 'ja';
const otherHref = otherLang === 'en' ? `/en/guide/${prop.slug}/` : `/guide/${prop.slug}/`;

const PIN = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`;
---

<div class="bar">
  <div class="bar-in">
    <span class="brand">Glocal · Yamanashi</span>
    {prop.sections.length > 1 && (
      <nav class="jump" aria-label={t.jumpLabel}>
        {prop.sections.map((s) => (
          <a href={`#${s.id || s.kind}`}>{s.title[lang]}</a>
        ))}
      </nav>
    )}
    <a class="lang" href={otherHref} hreflang={otherLang} rel="alternate">{t.other}</a>
  </div>
</div>

<main class="wrap">
  <header class="hero">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{prop.name[lang]}</h1>
    <p class="sub">{t.lead}</p>
  </header>

  {prop.sections.map((sec) => (
    <section class="sheet" id={sec.id || sec.kind}>
      <h2 class="sect">{sec.title[lang]}<span>{sec.spots.length}</span></h2>
      {sec.lead && sec.lead[lang] && <p class="sect-lead">{sec.lead[lang]}</p>}

      <SpotMap section={sec} lang={lang} />

      <div class="spots">
        {sec.spots.map((s) => (
          <article class="spot">
            <div class="body">
              <p class="tags">
                {s.no && <b class="no">{s.no}</b>}
                <span class="genre">{s.genre[lang]}</span>
              </p>
              <h3>{s.name[lang]}</h3>
              <p class="alt">{s.name[otherLang]}</p>

              {s.travel.length > 0 && (
                <p class="travel">
                  {s.travel.map((v) => <span>{v[lang]}</span>)}
                </p>
              )}

              {s.photo && (
                <img class="shot" src={s.photo} alt="" loading="lazy" decoding="async" />
              )}

              <p class="desc">{s.desc[lang]}</p>

              {(s.hours || s.closed) && (
                <p class="meta">
                  {s.hours}{s.hours && s.closed && ' / '}
                  {s.closed && `${t.closed} ${s.closed}`}
                </p>
              )}

              <p class="acts">
                <a class="maplink" href={s.map} target="_blank" rel="noopener">
                  <Fragment set:html={PIN} />{t.open}
                </a>
                {s.website && (
                  <a class="web" href={s.website} target="_blank" rel="noopener">{t.site}</a>
                )}
              </p>
            </div>

            <figure class="qr">
              <img src={s.qr} width="96" height="96" alt="" loading="lazy" />
              <figcaption>{t.qrCap}</figcaption>
            </figure>
          </article>
        ))}
      </div>

      {sec.note && <p class="note">{sec.note[lang]}</p>}
    </section>
  ))}

  <footer>
    {prop.name[lang]} · {t.foot}
    {prop.updated && <span class="upd">{t.updated} {prop.updated}</span>}
  </footer>
</main>

<script is:inline>
  // 上部バーの行き先に「いま読んでいるセクション」の印を付ける。
  // 行き先そのものはただのリンクなので、これが動かなくても移動はできる。
  //
  // IntersectionObserver だけだと、しきい値をまたがない範囲の移動
  //（長いセクションの中をスクロールする、など）で印が古いまま残る。
  // スクロールのたびに位置を測り直す形にしてある（rAFで1フレーム1回に間引く）。
  (function () {
    const nav = document.querySelector('.bar .jump');
    if (!nav) return;
    const links = Array.from(nav.querySelectorAll('a'));
    const pairs = [];
    links.forEach((a) => {
      const el = document.querySelector(a.getAttribute('href'));
      if (el) pairs.push([el, a]);
    });
    if (!pairs.length) return;

    const BAR = 80;            // 上部バーの高さぶん（.sheet の scroll-margin-top より少し大きく）
    let current = null;
    let queued = false;

    function pick() {
      queued = false;
      // 上部バーのすぐ下の線を、いちばん最後にまたいだセクション
      let found = pairs[0][1];
      for (const [el, a] of pairs) {
        if (el.getBoundingClientRect().top - BAR <= 0) found = a;
      }
      // 最後のセクションが短いと、押しても線まで上がりきらない。
      // ページの末尾まで来ていたら最後のセクションを現在地にする。
      const atEnd = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
      if (atEnd) found = pairs[pairs.length - 1][1];
      if (found === current) return;
      links.forEach((x) => x.removeAttribute('aria-current'));
      found.setAttribute('aria-current', 'true');
      current = found;
      // 横に流れて隠れているときは、見える位置まで寄せる
      const nr = nav.getBoundingClientRect();
      const ar = found.getBoundingClientRect();
      if (ar.left < nr.left || ar.right > nr.right) {
        nav.scrollTo({
          left: found.offsetLeft - nav.clientWidth / 2 + found.offsetWidth / 2,
          behavior: 'smooth',
        });
      }
    }

    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(pick);
    }

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    pick();
  })();
</script>

{mapsKey && (
  <script is:inline define:vars={{ mapsKey, mapsId }}>
    // セクション先頭の地図。data-spotmap に入っている値だけで描く。
    // 失敗してもページの本文には影響しない（地図の枠が空のまま残るだけ）。
    (function () {
      const nodes = Array.from(document.querySelectorAll('[data-spotmap]'));
      if (!nodes.length) return;

      ((g) => { let h, a, k, p = 'The Google Maps JavaScript API', c = 'google', l = 'importLibrary',
        q = '__ib__', m = document, b = window; b = b[c] || (b[c] = {});
        const d = b.maps || (b.maps = {}), r = new Set(), e = new URLSearchParams(),
        u = () => h || (h = new Promise(async (f, n) => {
          a = m.createElement('script'); e.set('libraries', [...r] + '');
          for (k in g) e.set(k.replace(/[A-Z]/g, (t) => '_' + t[0].toLowerCase()), g[k]);
          e.set('callback', c + '.maps.' + q); a.src = `https://maps.${c}apis.com/maps/api/js?` + e;
          d[q] = f; a.onerror = () => h = n(Error(p + ' could not load.'));
          m.head.append(a); }));
        d[l] ? console.warn(p + ' only loads once. Ignoring:', g)
             : d[l] = (f, ...n) => r.add(f) && u().then(() => d[l](f, ...n)); })
        ({ key: mapsKey, v: 'weekly', language: document.documentElement.lang || 'ja', region: 'JP' });

      function badge(text, home) {
        const el = document.createElement('div');
        el.className = 'gpin' + (home ? ' gpin-home' : '');
        el.textContent = text;
        return el;
      }

      // 地図が出せないとき（キーの制限・1日の上限・通信不良）は枠ごと消す。
      // カードはサーバ側で描いてあるので、ページの中身は欠けない。
      const giveUp = () => nodes.forEach((n) => { n.style.display = 'none'; });
      setTimeout(() => {
        if (!document.querySelector('.gmap .gpin')) giveUp();
      }, 8000);

      (async () => {
       try {
        const { Map } = await google.maps.importLibrary('maps');
        const { AdvancedMarkerElement } = await google.maps.importLibrary('marker');
        const { LatLngBounds } = await google.maps.importLibrary('core');

        for (const node of nodes) {
          let d;
          try { d = JSON.parse(node.dataset.spotmap); } catch (err) { continue; }
          const map = new Map(node, {
            mapId: mapsId,
            mapTypeControl: false,
            streetViewControl: false,
            fullscreenControl: true,
            gestureHandling: 'cooperative',
          });
          const info = new google.maps.InfoWindow();
          const b = new LatLngBounds(
            { lat: d.bounds.south, lng: d.bounds.west },
            { lat: d.bounds.north, lng: d.bounds.east });
          map.fitBounds(b, 40);

          if (d.home) {
            new AdvancedMarkerElement({ map, position: { lat: d.home.lat, lng: d.home.lng },
              content: badge(d.homeTag, true), title: d.home.label, zIndex: 99 });
          }
          d.spots.forEach((s) => {
            const mk = new AdvancedMarkerElement({ map, position: { lat: s.lat, lng: s.lng },
              content: badge(String(s.no)), title: s.name });
            mk.addListener('gmp-click', () => {
              info.setContent(
                '<div class="gpop"><b>' + s.no + '. ' + s.name + '</b>'
                + (s.travel ? '<span>' + s.travel + '</span>' : '')
                + '<a href="' + s.map + '" target="_blank" rel="noopener">' + d.open + '</a></div>');
              info.open({ map, anchor: mk });
            });
          });
        }
       } catch (err) {
        giveUp();
       }
      })();
    })();
  </script>
)}

<style is:global>
  .gpin {
    width: 26px; height: 26px; border-radius: 50%;
    background: #8a6736; color: #fff; border: 2px solid #fff;
    display: grid; place-items: center;
    font: 700 12px/1 system-ui, sans-serif;
    box-shadow: 0 1px 4px rgba(0, 0, 0, .35);
  }
  .gpin-home { background: #1d2a30; width: 30px; height: 30px; font-size: 11px; }
  .gpop { font-size: 13px; line-height: 1.6; max-width: 220px; }
  .gpop b { display: block; font-size: 14px; margin-bottom: 2px; }
  .gpop span { display: block; color: #34464e; }
  .gpop a { display: inline-block; margin-top: 4px; color: #8a6736; }
</style>

<style>
  .sect-lead {
    margin: -6px 0 14px; font-size: 13.5px; color: var(--muted, #5C6A7C);
  }
  /* 地図のピンと同じ番号。ジャンルの札の左に並べる */
  .tags {
    display: flex; align-items: center; gap: 7px; margin: 0 0 9px;
  }
  .tags .genre { margin-bottom: 0; }
  .no {
    flex: 0 0 19px;
    display: grid; place-items: center;
    width: 19px; height: 19px; border-radius: 50%;
    background: var(--sand-d); color: var(--white);
    font-size: 11px; font-weight: 700; line-height: 1;
  }
  .bar {
    position: sticky; top: 0; z-index: 10;
    background: rgba(246, 242, 234, .93);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar-in {
    max-width: 960px; margin: 0 auto; padding: 9px 20px;
    display: flex; align-items: center; gap: 14px;
  }
  .brand {
    font-size: 11px; letter-spacing: .26em; color: var(--sand-d); font-weight: 500;
    white-space: nowrap; flex: 0 0 auto;
  }
  /* 行き先が増えても折り返さず、横に流して出し切る。
     幅が足りない端末では屋号を引っ込めて、行き先の幅を優先する。 */
  @media (max-width: 760px) { .brand { display: none; } }
  .lang {
    font-size: 13px; letter-spacing: .08em; color: var(--sand-d);
    border: 1px solid var(--sand); border-radius: 2px; padding: 6px 16px;
  }
  .lang:hover { background: var(--sand); color: #fff; }

  .wrap { max-width: 960px; margin: 0 auto; padding: 36px 20px 72px; }

  .hero { margin-bottom: 8px; }
  .hero .eyebrow { margin-bottom: 12px; }
  .hero h1 { font-size: clamp(25px, 5.4vw, 34px); line-height: 1.35; }
  .hero .sub { color: var(--ink2); font-size: 14px; margin-top: 10px; max-width: 42em; }

  /* 上部バーの中。セクションが2つ以上あるときだけ出る。
     読んでいる途中でも行き先が見えているように、バーごと貼り付けてある。 */
  .jump {
    flex: 1 1 auto; min-width: 0;
    display: flex; gap: 8px;
    overflow-x: auto; scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-padding-inline: 20px;
  }
  .jump::-webkit-scrollbar { display: none; }
  .jump a {
    flex: 0 0 auto; white-space: nowrap;
    font-size: 12px; letter-spacing: .06em; color: var(--sand-d);
    border: 1px solid var(--sand); border-radius: 2px; padding: 6px 13px;
    transition: background .15s, color .15s;
  }
  .jump a:hover { background: var(--sand); color: #fff; }
  /* いま読んでいるセクション。JavaScriptが動かない端末では付かないだけ */
  .jump a[aria-current="true"] {
    background: var(--sand-d); color: #fff; border-color: var(--sand-d);
  }

  h2.sect {
    font-family: var(--sans); font-size: 11.5px; font-weight: 500;
    letter-spacing: .26em; text-transform: uppercase; color: var(--sand-d);
    margin: 52px 0 20px; display: flex; align-items: center; gap: 14px;
    scroll-margin-top: 72px;
  }
  h2.sect span {
    font-size: 11px; letter-spacing: .1em; color: var(--ink2);
    border: 1px solid var(--line); border-radius: 999px; padding: 1px 9px;
  }
  h2.sect::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  /* global.css の section{padding:96px 0} が効いてしまうので打ち消す。
     打ち消さないと、ナビとセクション見出しのあいだに96pxの空白が入る。 */
  .sheet { padding: 0; scroll-margin-top: 72px; }

  .spots { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 820px) { .spots { grid-template-columns: 1fr 1fr; } }

  .spot {
    background: var(--white); border: 1px solid var(--line);
    padding: 20px; display: flex; gap: 18px; align-items: flex-start;
  }
  .spot .body { flex: 1; min-width: 0; }

  .genre {
    display: inline-block; font-size: 10.5px; letter-spacing: .14em;
    color: var(--sand-d); background: var(--paper2);
    padding: 2px 9px; border-radius: 2px; margin-bottom: 9px;
  }
  .spot h3 { font-size: 17.5px; line-height: 1.45; }
  .alt { font-size: 12.5px; color: var(--ink2); margin-top: 2px; }

  .travel { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 7px; }
  .travel span {
    font-size: 12.5px; font-weight: 500; letter-spacing: .04em;
    color: var(--sand-d); background: var(--paper2);
    border-radius: 2px; padding: 3px 11px;
  }

  .shot {
    width: 100%; height: 150px; object-fit: cover;
    margin-top: 13px; border: 1px solid var(--line);
  }

  .desc { margin-top: 11px; font-size: 14px; color: var(--ink2); }
  .meta { margin-top: 9px; font-size: 12.5px; color: var(--ink2); }

  .acts { margin-top: 15px; display: flex; align-items: center; flex-wrap: wrap; gap: 14px; }
  .maplink {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--sand); color: #fff; padding: 11px 22px; border-radius: 2px;
    font-size: 14px; letter-spacing: .06em; font-weight: 500;
  }
  .maplink:hover { background: var(--sand-d); }
  .web { font-size: 13px; color: var(--sand-d); border-bottom: 1px solid var(--sand); }

  /* QRは手元の端末では読み取れない。広い画面でだけ出す。 */
  .qr { margin: 0; flex: none; text-align: center; display: none; }
  .qr img { width: 96px; height: 96px; border: 1px solid var(--line); }
  .qr figcaption {
    font-size: 10.5px; color: var(--ink2); margin-top: 5px;
    max-width: 104px; line-height: 1.5;
  }
  @media (min-width: 720px) { .qr { display: block; } }

  .note {
    margin-top: 18px; padding: 13px 17px;
    background: var(--paper2); border-left: 3px solid var(--sand);
    font-size: 13.5px; color: var(--ink);
  }

  footer {
    margin-top: 64px; padding-top: 22px; border-top: 1px solid var(--line);
    font-size: 12px; color: var(--ink2); line-height: 1.8;
  }
  footer .upd { display: block; margin-top: 4px; letter-spacing: .08em; }
</style>
