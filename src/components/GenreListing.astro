---
import { getCollection } from 'astro:content';
import PropertyCard from './PropertyCard.astro';
const { genre, eyebrow, title, lead, lang = 'ja' } = Astro.props;
const all = await getCollection('properties');
let items = all
  .filter((p) => p.data.genres.includes(genre))
  .sort((a, b) => a.data.order - b.data.order);
// 多言語版は該当言語データを持つ物件のみ表示
if (lang === 'en') items = items.filter((p) => p.data.en);
if (lang === 'zh') items = items.filter((p) => p.data.zh);
const emptyText = lang === 'en' ? 'Coming soon.' : lang === 'zh' ? '準備中。' : '現在準備中です。';
---
<section class="listing-hero">
  <div class="wrap">
    <div class="eyebrow">{eyebrow}</div>
    <h1>{title}</h1>
    <p>{lead}</p>
  </div>
</section>
<section class="listing">
  <div class="wrap">
    {items.length ? (
      <div class="grid">{items.map((p) => <PropertyCard property={p} lang={lang} />)}</div>
    ) : (
      <p class="empty">{emptyText}</p>
    )}
  </div>
</section>
<style>
  .listing-hero{padding:150px 0 50px;background:var(--paper2);text-align:center}
  .listing-hero h1{font-size:clamp(26px,3.4vw,40px);margin:6px 0 14px}
  .listing-hero p{font-size:15px;color:var(--ink2)}
  .listing{padding:64px 0 96px}
  .listing .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:30px}
  .empty{text-align:center;color:var(--ink2);padding:40px 0}
  @media(max-width:700px){ .listing .grid{grid-template-columns:1fr} }
</style>
