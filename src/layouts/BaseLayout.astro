---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description = '合同会社グローカルコミューン公式サイト', lang = 'ja' } = Astro.props;
const htmlLang = lang === 'zh' ? 'zh-Hant' : lang;
---
<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
    <script>
      const hdr = document.getElementById('hdr');
      const heroBg = document.querySelector('.hero-bg');
      function onScroll() {
        const y = window.pageYOffset;
        if (hdr) hdr.classList.toggle('scrolled', y > 60);
        if (heroBg && y < window.innerHeight)
          heroBg.style.transform = 'translateY(' + y * 0.32 + 'px)';
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      const io = new IntersectionObserver(
        (es) => {
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
