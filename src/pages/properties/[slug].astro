---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PropertyLP from '../../components/PropertyLP.astro';
import InstagramFeed from '../../components/InstagramFeed.astro';

export async function getStaticPaths() {
  const props = await getCollection('properties');
  return props.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const d = p.data;
const isStay = d.genres.includes('stay');

const t = {
  title: d.title,
  hero: d.hero,
  heroCta: 'ご予約・お問い合わせ',
  conceptHeading: d.concept.heading,
  conceptBody: d.concept.body,
  panorama: d.panorama ? { title: d.panorama.title, sub: d.panorama.sub } : null,
  featuresHeading: isStay ? 'この宿で過ごす理由' : '特徴',
  features: d.features.map((f) => ({ title: f.title, desc: f.desc })),
  special: d.special ? { eyebrow: d.special.eyebrow, title: d.special.title, body: d.special.body } : null,
  roomsHeading: '客室・設備',
  rooms: d.rooms.map((r) => ({ floor: r.floor, title: r.title, desc: r.desc })),
  floorplanCaption: '間取り図　— クリックで拡大',
  galleryHeading: 'ギャラリー',
  gallery: d.gallery.map((g) => ({ title: g.title, desc: g.desc })),
  amenitiesHeading: 'アメニティ・サービス',
  amenities: d.amenities.map((a) => a.label),
  specsHeading: '物件概要',
  specs: d.specs,
  specsNote: d.specsNote,
  accessHeading: 'アクセス・ご利用案内',
  addressLabel: '所在地',
  info: d.info,
  operatorLabel: '運営',
  operatorValue: '合同会社グローカルコミューン',
  contactLabel: 'お問い合わせ',
  contactHref: '/contact/',
  bookingNote: '',
  booking: {
    heading: d.booking.heading || 'ご予約・お問い合わせ',
    lead: d.booking.lead || '空室状況の確認・ご予約・お問い合わせは、お気軽にご連絡ください。',
    bookingLabel: d.booking.bookingLabel || 'Airbnbで予約する',
  },
};
---
<BaseLayout title={`${d.title} ｜ 合同会社グローカルコミューン`} description={d.summary}>
  <PropertyLP data={d} t={t} />
  {d.instagramWidgetId && <InstagramFeed lang="ja" widgetId={d.instagramWidgetId} />}
</BaseLayout>
