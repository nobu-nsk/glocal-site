---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const props = await getCollection('properties');
  return props.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const d = p.data;
---
<BaseLayout title={`${d.title} ｜ 合同会社グローカルコミューン`} description={d.summary}>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" style={`background-image:url('${d.hero.image}')`}></div>
    <div class="hero-inner">
      {d.hero.eyebrow && <div class="eyebrow">{d.hero.eyebrow}</div>}
      <h1 set:html={d.hero.title}></h1>
      <p set:html={d.hero.lead}></p>
      <a href="#booking" class="btn">ご予約・お問い合わせ</a>
    </div>
    <div class="scroll-cue">SCROLL</div>
  </section>

  <!-- CONCEPT -->
  <section id="concept">
    <div class="wrap concept">
      <div class="reveal">
        <div class="eyebrow">Concept</div>
        <h2 set:html={d.concept.heading}></h2>
        {d.concept.body.map((para: string) => <p>{para}</p>)}
      </div>
      <div class="imgwrap reveal"><img src={d.concept.image} alt={d.title} /></div>
    </div>
  </section>

  <!-- PANORAMA (full-bleed) -->
  {d.panorama && (
    <section class="pano reveal" aria-label="パノラマビュー">
      <img src={d.panorama.image} alt={d.panorama.title} />
      <div class="cap"><div class="t">{d.panorama.title}</div><div class="s">{d.panorama.sub}</div></div>
    </section>
  )}

  <!-- FEATURES -->
  {d.features.length > 0 && (
    <section id="features" class="features">
      <div class="wrap">
        <div class="feat-head reveal"><div class="eyebrow">Features</div><h2>この宿で過ごす理由</h2></div>
        <div class="feat-grid">
          {d.features.map((f: any) => (
            <div class="feat reveal"><div class="ic">{f.icon}</div><h3>{f.title}</h3><p>{f.desc}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SPECIAL (施設ごとの特別な特徴枠) -->
  {d.special && (
    <section class="special" style={`background:linear-gradient(rgba(18,26,30,.6),rgba(18,26,30,.6)),url('${d.special.image}') center/cover fixed;`}>
      <div class="wrap reveal">
        <div class="eyebrow">{d.special.eyebrow}</div>
        <h2>{d.special.title}</h2>
        <p>{d.special.body}</p>
      </div>
    </section>
  )}

  <!-- ROOMS & FACILITIES -->
  {d.rooms.length > 0 && (
    <section id="rooms" class="rooms">
      <div class="wrap">
        <div class="gal-head reveal"><div class="eyebrow">Rooms &amp; Facilities</div><h2>客室・設備</h2></div>
        <div class="room-grid">
          {d.rooms.map((r: any) => (
            <div class="room reveal">
              <img src={r.image} alt={r.title} loading="lazy" />
              <div class="body"><div class="floor">{r.floor}</div><h3>{r.title}</h3><p>{r.desc}</p></div>
            </div>
          ))}
        </div>
        {d.floorplan && (
          <figure class="floorplan reveal" id="floorplan">
            <img src={d.floorplan} alt={`${d.title} 間取り図`} />
            <figcaption>間取り図（1F / 2F）　— クリックで拡大</figcaption>
          </figure>
        )}
      </div>
    </section>
  )}

  <!-- GALLERY (center-mode carousel) -->
  {d.gallery.length > 0 && (
    <section id="gallery">
      <div class="wrap">
        <div class="gal-head reveal"><div class="eyebrow">Gallery</div><h2>ギャラリー</h2></div>
        <div class="carousel reveal">
          <button class="c-btn c-prev" aria-label="前の写真">‹</button>
          <div class="viewport">
            <div class="track" id="gtrack">
              {d.gallery.map((g: any) => (
                <div class="slide">
                  <img src={g.image} alt={g.title} loading="lazy" />
                  <div class="cap"><div class="t">{g.title}</div><div class="s">{g.desc}</div></div>
                </div>
              ))}
            </div>
          </div>
          <button class="c-btn c-next" aria-label="次の写真">›</button>
        </div>
      </div>
    </section>
  )}

  <!-- AMENITIES -->
  {d.amenities.length > 0 && (
    <section id="amenities" class="amenities">
      <div class="wrap">
        <div class="gal-head reveal"><div class="eyebrow">Amenities &amp; Services</div><h2>アメニティ・サービス</h2></div>
        <div class="am-grid reveal">
          {d.amenities.map((a: any) => (<div class="am"><i>{a.icon}</i>{a.label}</div>))}
        </div>
      </div>
    </section>
  )}

  <!-- ACCESS & INFORMATION -->
  <section id="access">
    <div class="wrap access">
      <div class="reveal">
        <div class="eyebrow">Access &amp; Information</div>
        <h2>アクセス・ご利用案内</h2>
        <table class="infotable">
          <tr><th>所在地</th><td>{d.location.address}</td></tr>
          {d.info.map((row: any) => (<tr><th>{row.label}</th><td>{row.value}</td></tr>))}
          <tr><th>運営</th><td>合同会社グローカルコミューン</td></tr>
        </table>
      </div>
      <div class="reveal">
        <iframe loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen src={d.location.mapEmbed} title={`${d.title} 所在地`}></iframe>
      </div>
    </div>
  </section>

  <!-- BOOKING -->
  <section id="booking" class="booking">
    <div class="wrap reveal">
      <div class="eyebrow">Reservation</div>
      <h2>富士山と過ごす休日を、あなたに。</h2>
      <p>空室状況の確認・ご予約は各予約サイトより承っております。お気軽にお問い合わせください。</p>
      <div class="btns">
        {d.booking.airbnb && <a href={d.booking.airbnb} target="_blank" rel="noopener" class="btn">Airbnbで予約する</a>}
        <a href={d.booking.contact || '/#contact'} class="btn dark">お問い合わせ</a>
      </div>
      <p class="note">※ 予約カレンダー・お問い合わせは、Beds24予約エンジン等へ差し替え可能です。</p>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div id="lightbox" class="lb" aria-hidden="true">
    <button class="lb-btn lb-close" aria-label="閉じる">✕</button>
    <button class="lb-btn lb-prev" aria-label="前の写真">‹</button>
    <img class="lb-img" src="" alt="" />
    <button class="lb-btn lb-next" aria-label="次の写真">›</button>
    <div class="lb-cap"></div>
  </div>
</BaseLayout>

<style>
  .hero{position:relative;height:100vh;min-height:600px;overflow:hidden;display:flex;align-items:center;justify-content:center;text-align:center;padding:0}
  .hero-bg{position:absolute;inset:-8% 0;background-size:cover;background-position:center;background-repeat:no-repeat;will-change:transform}
  .hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,30,35,.5),rgba(20,30,35,.18) 38%,rgba(20,30,35,.62))}
  .hero-inner{position:relative;z-index:2;color:#fff;padding:0 24px}
  .hero-inner .eyebrow{color:#fff;opacity:.9}
  .hero h1{color:#fff;font-size:clamp(28px,4.6vw,52px);line-height:1.5;text-shadow:0 2px 22px rgba(0,0,0,.3)}
  .hero p{margin-top:22px;font-size:clamp(14px,1.5vw,16px);letter-spacing:.06em;opacity:.95}
  .hero .btn{margin-top:36px}
  .scroll-cue{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);z-index:2;color:#fff;font-size:10px;letter-spacing:.3em;writing-mode:vertical-rl;opacity:.8}
  .scroll-cue::after{content:"";display:block;width:1px;height:42px;background:#fff;margin:12px auto 0;animation:cue 2s ease-in-out infinite}
  @keyframes cue{0%,100%{transform:scaleY(.3);opacity:.3;transform-origin:top}50%{transform:scaleY(1);opacity:1;transform-origin:top}}

  .concept{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center}
  .concept h2{font-size:clamp(21px,2.5vw,32px);margin-bottom:24px}
  .concept p{margin-bottom:16px;font-size:15px}
  .concept .imgwrap{overflow:hidden;border-radius:2px}
  .concept img{width:100%;height:460px;object-fit:cover;background:var(--paper2);transition:transform 1.2s ease}
  .concept .imgwrap:hover img{transform:scale(1.05)}

  .pano{position:relative;line-height:0;overflow:hidden;padding:0}
  .pano img{width:100%;height:auto;display:block;min-height:220px;object-fit:cover}
  .pano .cap{position:absolute;left:0;right:0;bottom:0;line-height:1.6;padding:38px 24px 26px;text-align:center;color:#fff;background:linear-gradient(transparent,rgba(18,26,30,.6))}
  .pano .cap .t{font-family:var(--serif);font-size:clamp(18px,2.4vw,28px);letter-spacing:.05em}
  .pano .cap .s{font-size:13px;opacity:.92;letter-spacing:.12em;margin-top:4px}

  .features{background:var(--paper2)}
  .feat-head{text-align:center;margin-bottom:56px}
  .feat-head h2{font-size:clamp(22px,2.6vw,30px)}
  .feat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px}
  .feat{text-align:center;padding:6px}
  .feat .ic{width:58px;height:58px;margin:0 auto 20px;border:1px solid var(--sand);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--sand-d);font-size:24px}
  .feat h3{font-size:17px;margin-bottom:10px}
  .feat p{font-size:13px;line-height:1.8}

  .special{position:relative;color:#fff;text-align:center}
  .special h2{color:#fff;font-size:clamp(22px,2.8vw,34px);margin-bottom:24px}
  .special .eyebrow{color:#e6c79a}
  .special p{max-width:640px;margin:0 auto;font-size:15px;opacity:.94}

  .room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .room{background:var(--white);border:1px solid var(--line);border-radius:2px;overflow:hidden;cursor:pointer}
  .room img{width:100%;height:230px;object-fit:cover;transition:transform 1s}
  .room:hover img{transform:scale(1.05)}
  .room .body{padding:22px 24px}
  .room .floor{font-size:11px;letter-spacing:.2em;color:var(--sand-d);font-weight:500}
  .room h3{font-size:18px;margin:8px 0 10px}
  .room p{font-size:13px;line-height:1.8}
  .floorplan{max-width:760px;margin:44px auto 0;cursor:pointer}
  .floorplan img{width:100%;border:1px solid var(--line);border-radius:2px;background:#fff}
  .floorplan figcaption{text-align:center;font-size:12px;letter-spacing:.1em;color:var(--sand-d);margin-top:10px}

  .carousel{position:relative}
  .viewport{overflow:hidden}
  .track{display:flex;gap:18px;will-change:transform;transition:transform .5s ease}
  .slide{flex:0 0 auto;width:clamp(280px,72vw,720px);position:relative;border-radius:2px;overflow:hidden;cursor:pointer;opacity:.4;transform:scale(.9);transition:opacity .5s ease,transform .5s ease}
  .slide img{width:100%;height:clamp(240px,52vh,460px);object-fit:cover;display:block}
  .slide .cap{position:absolute;left:0;right:0;bottom:0;padding:18px 22px;color:#fff;background:linear-gradient(transparent,rgba(18,26,30,.72));opacity:0;transition:opacity .4s}
  .slide .cap .t{font-family:var(--serif);font-size:17px;letter-spacing:.04em}
  .slide .cap .s{font-size:13px;opacity:.92;margin-top:3px}
  .slide.active{opacity:1;transform:scale(1)}
  .slide.active .cap{opacity:1}
  .c-btn{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;background:rgba(246,242,234,.92);border:1px solid var(--line);color:var(--ink);font-size:22px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:5;transition:background .3s}
  .c-btn:hover{background:#fff}
  .c-prev{left:6px}.c-next{right:6px}

  .amenities{background:var(--paper2)}
  .am-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px 30px;margin-top:44px}
  .am{display:flex;align-items:center;gap:12px;font-size:14px;padding:14px 0;border-bottom:1px solid var(--line)}
  .am i{color:var(--sand-d);font-style:normal;font-size:18px;width:22px;text-align:center}

  .access{display:grid;grid-template-columns:1fr 1fr;gap:54px;align-items:start}
  .access h2{font-size:clamp(22px,2.6vw,30px);margin-bottom:24px}
  .access iframe{width:100%;height:380px;border:0;border-radius:2px;filter:grayscale(.2)}
  .infotable{width:100%;border-collapse:collapse;margin-top:8px}
  .infotable th,.infotable td{text-align:left;padding:15px 4px;border-bottom:1px solid var(--line);font-size:14px;vertical-align:top;font-weight:300}
  .infotable th{width:38%;font-family:var(--serif);font-weight:600;color:var(--ink);letter-spacing:.05em}

  .booking{text-align:center;background:var(--ink);color:#fff}
  .booking .eyebrow{color:#e6c79a}
  .booking h2{color:#fff;font-size:clamp(24px,3vw,38px);margin-bottom:22px}
  .booking p{max-width:560px;margin:0 auto 38px;opacity:.9;font-size:15px}
  .booking .btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
  .booking .note{margin-top:30px;font-size:11.5px;opacity:.55;letter-spacing:.04em}

  .lb{position:fixed;inset:0;background:rgba(15,20,22,.93);display:none;align-items:center;justify-content:center;z-index:100}
  .lb.open{display:flex}
  .lb-img{max-width:92vw;max-height:84vh;object-fit:contain;border-radius:2px}
  .lb-cap{position:absolute;bottom:22px;left:0;right:0;text-align:center;color:#fff;font-family:var(--serif);font-size:15px;letter-spacing:.05em}
  .lb-btn{position:absolute;background:none;border:0;color:#fff;cursor:pointer;opacity:.85;transition:opacity .2s;line-height:1}
  .lb-btn:hover{opacity:1}
  .lb-close{top:20px;right:24px;font-size:30px}
  .lb-prev,.lb-next{top:50%;transform:translateY(-50%);font-size:44px;padding:8px 16px}
  .lb-prev{left:8px}.lb-next{right:8px}

  @media(max-width:860px){
    .hero{height:72vh;min-height:440px}
    .hero-bg{inset:-4% 0;background-position:center 32%}
    .concept{grid-template-columns:1fr;gap:30px}.concept img{height:300px}
    .feat-grid{grid-template-columns:repeat(2,1fr);gap:36px 26px}
    .room-grid{grid-template-columns:repeat(2,1fr);gap:16px}
    .am-grid{grid-template-columns:repeat(2,1fr)}
    .access{grid-template-columns:1fr;gap:40px}
    .special{background-attachment:scroll !important}
  }
  @media(max-width:600px){ .slide img{height:210px} .lb-prev,.lb-next{font-size:32px} }
</style>

<script>
  const track = document.getElementById('gtrack');
  const slides = track ? Array.from(track.children) : [];
  let active = 0;
  function layout() {
    if (!slides.length || !track) return;
    const vp = track.parentElement.clientWidth;
    const s = slides[active];
    track.style.transform = 'translateX(' + (vp / 2 - (s.offsetLeft + s.offsetWidth / 2)) + 'px)';
    slides.forEach((el, i) => el.classList.toggle('active', i === active));
  }
  function go(i) { active = Math.max(0, Math.min(slides.length - 1, i)); layout(); }
  document.querySelector('.c-prev')?.addEventListener('click', () => go(active - 1));
  document.querySelector('.c-next')?.addEventListener('click', () => go(active + 1));
  window.addEventListener('resize', layout);
  window.addEventListener('load', layout);
  setTimeout(layout, 60); layout();

  const lb = document.getElementById('lightbox');
  if (lb) {
    const lbImg = lb.querySelector('.lb-img');
    const lbCap = lb.querySelector('.lb-cap');
    let group = [], idx = 0;
    const render = () => { const it = group[idx]; lbImg.src = it.src; lbImg.alt = it.cap || ''; lbCap.textContent = it.cap || ''; };
    const open = (items, i) => { group = items; idx = i; render(); lb.classList.add('open'); document.body.style.overflow = 'hidden'; };
    const close = () => { lb.classList.remove('open'); document.body.style.overflow = ''; };
    const move = (dir) => { idx = (idx + dir + group.length) % group.length; render(); };
    slides.forEach((s, i) => {
      s.addEventListener('click', () => {
        if (i !== active) { go(i); return; }
        open(slides.map((el) => ({ src: el.querySelector('img').getAttribute('src'), cap: el.querySelector('.cap .t')?.textContent || '' })), i);
      });
    });
    const rooms = Array.from(document.querySelectorAll('.room-grid .room'));
    rooms.forEach((el, i) => {
      el.addEventListener('click', () => {
        open(rooms.map((r) => ({ src: r.querySelector('img').getAttribute('src'), cap: r.querySelector('h3')?.textContent || '' })), i);
      });
    });
    const fp = document.getElementById('floorplan');
    fp?.addEventListener('click', () => { open([{ src: fp.querySelector('img').getAttribute('src'), cap: '間取り図（1F / 2F）' }], 0); });
    lb.querySelector('.lb-close').addEventListener('click', close);
    lb.querySelector('.lb-prev').addEventListener('click', (e) => { e.stopPropagation(); move(-1); });
    lb.querySelector('.lb-next').addEventListener('click', (e) => { e.stopPropagation(); move(1); });
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') close(); else if (e.key === 'ArrowLeft') move(-1); else if (e.key === 'ArrowRight') move(1);
    });
  }
</script>
