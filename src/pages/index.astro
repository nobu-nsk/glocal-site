---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import NewsList from '../components/NewsList.astro';
import { NEWS_UI } from '../content.config';

const all = await getCollection('properties');
const stays = all
  .filter((p) => p.data.genres.includes('stay'))
  .sort((a, b) => a.data.order - b.data.order);

const newsUi = NEWS_UI.ja;
const newsItems = (await getCollection('news'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4)
  .map((n) => ({
    date: n.data.date,
    category: n.data.category,
    title: n.data.title,
    summary: n.data.summary,
    href: n.data.body ? `/news/${n.id}/` : n.data.link || null,
  }));

const businesses = [
  { no: '01', title: '宿泊事業', desc: '暮らすように泊まる宿。富士河口湖・春日居温泉で、一棟貸しのプライベートな滞在を提供します。' },
  { no: '02', title: '賃貸・住まい事業', desc: '賃貸アパート・戸建ての運営、住居確保のための居住支援、空き家再生による地域活性化・移住促進。' },
  { no: '03', title: '多文化共生事業', desc: '多様な背景を持つ人々とともに暮らせる地域づくり。英語教室やウクライナ支援などに取り組みます。' },
  { no: '04', title: '産業衛生事業', desc: '働く人の健康づくりを支援。専門的な知見から、健やかに働ける環境づくりに貢献します。' },
];
---
<BaseLayout title="合同会社グローカルコミューン ｜ 世界のこと、地域のこと、一緒に取り組もう。">
  <section class="hero">
    <div class="hero-bg" style="background-image:url('/images/gfk/hero.jpg')"></div>
    <div class="hero-inner">
      <div class="eyebrow">合同会社グローカルコミューン</div>
      <h1>世界のこと、地域のこと、<br />一緒に取り組もう。</h1>
      <p>「グローバル」 ＋ 「ローカル」 ＝ 「グローカル」。<br />地球規模の視野で、地域に根ざして。明日のまちづくりへ。</p>
      <div class="hrow">
        <a href="/stay/" class="btn">宿泊施設を見る</a>
        <a href="#business" class="btn ghost">事業を知る</a>
      </div>
    </div>
    <div class="scroll-cue">SCROLL</div>
  </section>

  <a href="/saigai-shien/" class="ss-band" aria-label="災害で被災された方の受け入れについて">
    <span class="ss-tag">お知らせ</span>
    <span class="ss-txt">災害で被災された方を、宿泊施設・賃貸物件へ優先的にお迎えします。ご相談ください。</span>
    <span class="ss-arrow" aria-hidden="true">→</span>
  </a>

  <section id="concept">
    <div class="wrap concept">
      <div class="reveal">
        <div class="eyebrow">Concept</div>
        <h2>グローバルな視野で、<br />地域から行動する。</h2>
        <p>「グローカル」とは、グローバル（地球規模）とローカル（地域）を合わせた造語です。「コミューン」は共同体や地域を意味します。</p>
        <p>グローカルコミューンは、地球規模の視野で社会を捉えつつ、地域に根ざした視点で、明日のまちづくりに貢献していきます。</p>
        <a href="#company" class="more">会社概要を見る</a>
      </div>
      <div class="imgwrap reveal">
        <img src="https://glocalcommune.sakura.ne.jp/wp/wp-content/uploads/2024/01/%E5%9C%B0%E7%90%83%E3%81%A8%E4%BA%BA%E3%80%85-1.png" alt="地球と人々" />
      </div>
    </div>
  </section>

  <section id="business" class="business">
    <div class="wrap">
      <div class="sec-head reveal"><div class="eyebrow">Our Business</div><h2>4つの事業</h2></div>
      <div class="biz-grid">
        {businesses.map((b) => (
          <div class="biz reveal"><div class="no">{b.no}</div><h3>{b.title}</h3><p>{b.desc}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section id="stay" class="stay">
    <div class="wrap">
      <div class="sec-head reveal"><div class="eyebrow">Stay</div><h2>宿泊施設</h2></div>
      <div class="pgrid">{stays.map((p) => <PropertyCard property={p} />)}</div>
      <div class="center"><a href="/stay/" class="more">宿泊施設の一覧へ</a></div>
    </div>
  </section>

  <section id="props" class="props">
    <div class="wrap">
      <div class="sec-head reveal"><div class="eyebrow">Properties</div><h2>賃貸・物件</h2></div>
      <div class="prop-grid">
        <a class="prop reveal" href="/resort-rental/"><h3>リゾート賃貸 ― 二拠点・移住準備に</h3><p>二拠点生活や移住の準備に最適なリゾート賃貸。地域での暮らしを試しながら、次の住まいを整えられます。</p><span class="more">物件を見る</span></a>
        <a class="prop reveal" href="/residence/"><h3>居住用賃貸・居住支援</h3><p>賃貸アパート・戸建ての運営に加え、住まいの確保を支える居住支援に取り組んでいます。</p><span class="more">物件を見る</span></a>
      </div>
    </div>
  </section>

  <section id="commit">
    <div class="wrap">
      <div class="sec-head reveal"><div class="eyebrow">Our Commitment</div><h2>取り組み</h2></div>
      <div class="commit-grid">
        <div class="commit reveal"><div class="en">ENGLISH WITH NICA</div><h3>ニカの英語教室</h3><p>地域に根ざした英語教室。多様な文化にふれながら、子どもから大人まで学べる場を提供します。</p></div>
        <div class="commit reveal"><div class="en">SUPPORT FOR UKRAINE</div><h3>ウクライナ支援</h3><p>困難な状況にある人々とともに。多文化共生の視点から、できる支援を続けています。</p></div>
      </div>
    </div>
  </section>

  {newsItems.length > 0 && (
    <section id="news" class="news">
      <div class="wrap">
        <div class="sec-head reveal"><div class="eyebrow">News</div><h2>お知らせ</h2></div>
        <NewsList items={newsItems} lang="ja" />
        <div class="center"><a href="/news/" class="more">{newsUi.all}</a></div>
      </div>
    </section>
  )}

  <section id="company">
    <div class="wrap">
      <div class="company reveal">
        <div class="eyebrow">Company</div>
        <h2>会社情報</h2>
        <table class="infotable">
          <tr><th>会社名</th><td>合同会社グローカルコミューン</td></tr>
          <tr><th>所在地</th><td>山梨県甲府市湯村1-1-16</td></tr>
          <tr><th>事業内容</th><td>宿泊事業／賃貸・住まい事業／多文化共生事業／産業衛生事業</td></tr>
          <tr><th>ビジョン</th><td>世界とつながった地元<br />世界のこと、地域のこと、一緒に取り組もう</td></tr>
        </table>
      </div>
    </div>
  </section>

  <section id="contact" class="cta">
    <div class="wrap reveal">
      <div class="eyebrow">Contact</div>
      <h2>お問い合わせ・ご予約</h2>
      <p>事業のご相談、宿泊のご予約、取材・協業のお問い合わせなど、お気軽にご連絡ください。</p>
      <div class="hrow center"><a href="/contact/" class="btn">お問い合わせ</a><a href="/stay/" class="btn dark">宿泊の予約</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero{position:relative;height:100vh;min-height:600px;overflow:hidden;display:flex;align-items:center;justify-content:center;text-align:center;padding:0}
  .hero-bg{position:absolute;inset:-8% 0;background-size:cover;background-position:center;background-repeat:no-repeat;will-change:transform}
  .hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,30,35,.5),rgba(20,30,35,.2) 40%,rgba(20,30,35,.6))}
  .hero-inner{position:relative;z-index:2;color:#fff;padding:0 24px}
  .hero-inner .eyebrow{color:#fff;opacity:.92}
  .hero h1{color:#fff;font-size:clamp(28px,4.6vw,52px);line-height:1.5;text-shadow:0 2px 22px rgba(0,0,0,.3)}
  .hero p{margin-top:22px;font-size:clamp(14px,1.5vw,16px);letter-spacing:.06em;opacity:.95}
  .hrow{margin-top:36px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  .center{text-align:center;margin-top:30px;justify-content:center}
  .scroll-cue{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);z-index:2;color:#fff;font-size:10px;letter-spacing:.3em;writing-mode:vertical-rl;opacity:.8}
  .scroll-cue::after{content:"";display:block;width:1px;height:42px;background:#fff;margin:12px auto 0;animation:cue 2s ease-in-out infinite}
  @keyframes cue{0%,100%{transform:scaleY(.3);opacity:.3;transform-origin:top}50%{transform:scaleY(1);opacity:1;transform-origin:top}}

  .ss-band{display:flex;align-items:center;gap:16px;justify-content:center;flex-wrap:wrap;
    background:var(--ink);color:#fff;padding:16px 24px;text-align:center;transition:background .3s}
  .ss-band:hover{background:#24343b}
  .ss-band .ss-tag{font-size:11px;letter-spacing:.14em;background:var(--sand);color:#fff;padding:4px 12px;border-radius:2px;white-space:nowrap}
  .ss-band .ss-txt{font-size:14px;letter-spacing:.02em;color:#fff}
  .ss-band .ss-arrow{color:#e6c79a;font-size:15px}

  .concept{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center}
  .concept h2{font-size:clamp(21px,2.5vw,30px);margin-bottom:24px}
  .concept p{margin-bottom:16px;font-size:15px}
  .concept .imgwrap{overflow:hidden;border-radius:2px}
  .concept img{width:100%;height:420px;object-fit:cover;background:var(--paper2);transition:transform 1.2s ease}
  .concept .imgwrap:hover img{transform:scale(1.05)}

  .business{background:var(--paper2)}
  .biz-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
  .biz{background:var(--white);border:1px solid var(--line);border-radius:2px;padding:30px 24px;transition:transform .4s,box-shadow .4s}
  .biz:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(29,42,48,.09)}
  .biz .no{font-family:var(--serif);font-size:13px;color:var(--sand);letter-spacing:.1em}
  .biz h3{font-size:18px;margin:10px 0 12px}
  .biz p{font-size:13px;line-height:1.85}

  .pgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:30px}
  .prop-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:26px}
  .props{background:var(--paper2)}
  .prop{background:var(--white);border:1px solid var(--line);border-radius:2px;padding:30px;display:flex;flex-direction:column;gap:10px;transition:transform .4s,box-shadow .4s}
  .prop:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(29,42,48,.09)}
  .prop h3{font-size:18px}
  .prop p{font-size:13.5px}

  .commit-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:26px}
  .commit{border:1px solid var(--line);border-radius:2px;padding:28px 30px;background:var(--white)}
  .commit .en{font-size:11px;letter-spacing:.24em;color:var(--sand-d)}
  .commit h3{font-size:18px;margin:6px 0 10px}
  .commit p{font-size:13.5px}

  .news{background:var(--paper2)}
  .news-list{max-width:840px;margin:0 auto}
  .news-item{display:flex;gap:24px;align-items:baseline;padding:18px 4px;border-bottom:1px solid var(--line)}
  .news-item .date{font-family:var(--serif);font-size:13px;color:var(--sand-d);min-width:110px;letter-spacing:.05em}
  .news-item .cat{font-size:11px;border:1px solid var(--line);padding:2px 10px;border-radius:2px;color:var(--ink2);white-space:nowrap}
  .news-item .ttl{font-size:14.5px}

  .company{max-width:760px;margin:0 auto}
  .company h2{font-size:clamp(21px,2.5vw,29px);margin-bottom:22px}
  .infotable{width:100%;border-collapse:collapse}
  .infotable th,.infotable td{text-align:left;padding:13px 4px;border-bottom:1px solid var(--line);font-size:14px;font-weight:300;vertical-align:top}
  .infotable th{width:34%;font-family:var(--serif);font-weight:600;color:var(--ink);letter-spacing:.04em}
  .company iframe{width:100%;height:340px;border:0;border-radius:2px;filter:grayscale(.2)}

  .cta{text-align:center;background:var(--ink);color:#fff}
  .cta .eyebrow{color:#e6c79a}
  .cta h2{color:#fff;font-size:clamp(22px,2.8vw,34px);margin-bottom:18px}
  .cta p{max-width:540px;margin:0 auto 0;opacity:.9;font-size:15px}

  @media(max-width:860px){
    .hero{height:72vh;min-height:440px}
    .hero-bg{inset:-4% 0;background-position:center 32%}
    .concept{grid-template-columns:1fr;gap:30px}.concept img{height:300px}
    .biz-grid{grid-template-columns:repeat(2,1fr)}
    .prop-grid,.commit-grid,.company{grid-template-columns:1fr}
    .company{gap:34px}
    .news-item{flex-wrap:wrap;gap:8px}.news-item .date{min-width:auto}
  }
</style>
